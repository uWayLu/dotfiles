svnlogf() {
  command -v svn >/dev/null 2>&1 || { echo "缺 svn"; return 1; }

  svn log \
    | grep '^r[0-9]\+ ' \
    | fzf --preview '
        r=$(echo {} | awk "{print \$1}" | sed "s/^r//")
        [ -n "$r" ] && svn diff -c "$r"
      '
}

svncatf() {
  command -v svn >/dev/null 2>&1 || { echo "缺 svn"; return 1; }
  svn list -R \
    | fzf --preview 'svn cat -- "{}" 2>/dev/null | head -n 220'
}

# ---------- 系統 ----------
psk() {
  local line pid
  line="$(ps aux | fzf --header='選一個 process 後送 SIGTERM（-9）' --preview 'echo "{}"')" || return
  pid="$(echo "$line" | awk '{print $2}')"
  [[ -n "$pid" ]] && kill -9 "$pid"
}

psres() {
  local line pid
  local -a cmd_args # 宣告陣列來精確存放參數
  
  line="$(ps aux | fzf --header='選一個 process 強制中斷並於背景重啟' --preview 'echo "{}"')" || return
  pid="$(echo "$line" | awk '{print $2}')"
  [[ -n "$pid" ]] || return

  # 從 /proc 讀取精準的啟動參數（Zsh 語法：以 \0 分割字串存入陣列）
  if [[ -r "/proc/$pid/cmdline" ]]; then
    cmd_args=( ${(0)"$(< /proc/$pid/cmdline)"} )
  else
    echo "無法讀取 PID $pid 的 cmdline (可能權限不足或已結束)"
    return 1
  fi

  [[ ${#cmd_args[@]} -eq 0 ]] && { echo "指令為空"; return 1; }

  echo "Kill PID: $pid"
  kill -9 "$pid" 2>/dev/null
  
  # 稍微等一下，確保 port 或資源被系統釋放
  sleep 0.5

  # 用 (q) 標記安全地印出帶有正確跳脫字元的指令讓你看
  echo "Restarting: ${(q)cmd_args}"
  
  # 直接以陣列形式執行，不透過 eval，完美避開引號與 * 號展開問題
  "${cmd_args[@]}" &!
}

