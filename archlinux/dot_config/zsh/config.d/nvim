nvim() (
  wid="${KITTY_WINDOW_ID:-}"

  restore_kitty_spacing() {
    [ -n "$wid" ] || return 0
    command -v kitten >/dev/null 2>&1 || return 0

    kitten @ set-spacing \
      --match "id:$wid" \
      padding=default \
      margin=default \
      >/dev/null 2>&1 || true
  }

  if [ -n "$wid" ] && command -v kitten >/dev/null 2>&1; then
    kitten @ set-spacing \
      --match "id:$wid" \
      padding=0 \
      margin=0 \
      >/dev/null 2>&1 || true

    trap 'restore_kitty_spacing' EXIT
    trap 'exit 129' HUP
    trap 'exit 130' INT
    trap 'exit 143' TERM
  fi

  command nvim "$@"
  _nvim_ret=$?
  exit "$_nvim_ret"
)
