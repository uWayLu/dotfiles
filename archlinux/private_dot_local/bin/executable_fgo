#!/usr/bin/env bash
set -u  # 不用 set -e，因為我們要自己處理錯誤碼與重試

export PATH="$PATH:/opt/android-sdk/platform-tools"
echo "PATH=$PATH"

LOCAL_PORT=5556
REMOTE_PORT=5566
DEVICE="localhost:$LOCAL_PORT"

APP=(scrcpy -s "$DEVICE" --no-audio)

MAX_RETRY=3
SLEEP_BETWEEN=1

# tunnel PID 檔（比 pkill -f 安全很多）
TUNNEL_PIDFILE="${XDG_RUNTIME_DIR:-/tmp}/fgo_ssh_tunnel_${LOCAL_PORT}.pid"

retry() {
  # 用法: retry <cmd> [args...]
  local n=1
  while true; do
    "$@"
    local rc=$?
    if [[ $rc -eq 0 ]]; then
      return 0
    fi

    if [[ $n -ge $MAX_RETRY ]]; then
      echo "ERROR: command failed after $n attempts (rc=$rc): $*" >&2
      return $rc
    fi

    echo "WARN: command failed (attempt $n/$MAX_RETRY, rc=$rc): $*" >&2
    n=$((n+1))
    sleep "$SLEEP_BETWEEN"
  done
}

device_ready() {
  adb devices >/dev/null 2>&1 || return $?

  # 必須看到 device 狀態
  adb devices 2>/dev/null | awk 'NR>1 {print $1,$2}' | grep -q "^${DEVICE}[[:space:]]device$" || return 1

  # 關鍵：真的能 shell 才算 ready（避免假連線/半死）
  adb -s "$DEVICE" shell true >/dev/null 2>&1 || return 1
  return 0
}

run_wsl_cmd() {
  systemctl --user status ssh-tunnel-win11.service >/dev/null 2>&1
  local rc=$?
  if [[ $rc -eq 0 ]]; then
    echo "ssh-tunnel-win11.service is active."
    retry ssh wsl "bash -lc 'ssh_tun_bluestacks fgo'"
    rc=$?
    [[ $rc -eq 0 ]] && echo "Run cmd on remote WSL"
    return $rc
  else
    echo "ssh-tunnel-win11.service is not active."
    return 1
  fi
}

stop_tunnel_if_any() {
  if [[ -f "$TUNNEL_PIDFILE" ]]; then
    local oldpid
    oldpid="$(cat "$TUNNEL_PIDFILE" 2>/dev/null || true)"
    if [[ -n "${oldpid:-}" ]] && kill -0 "$oldpid" 2>/dev/null; then
      kill "$oldpid" >/dev/null 2>&1 || true
    fi
    rm -f "$TUNNEL_PIDFILE" >/dev/null 2>&1 || true
  fi
}

start_tunnel() {
  stop_tunnel_if_any

  # -f: 背景化；ExitOnForwardFailure: forward 不成功就直接失敗，避免假成功
  # keepalive: 讓死掉的連線快點死透，不要卡一個半死 tunnel
  ssh -fNL "${LOCAL_PORT}:0.0.0.0:${REMOTE_PORT}" wsl \
    -o ExitOnForwardFailure=yes \
    -o ServerAliveInterval=10 \
    -o ServerAliveCountMax=2

  # ssh -f 會讓 $! 成為 ssh 的 PID（夠用來 kill）
  echo $! >"$TUNNEL_PIDFILE"
}

connect_device() {
  # 先斷開一次，清理舊狀態（避免 offline/舊連線殘留）
  adb disconnect "$DEVICE" >/dev/null 2>&1 || true

  # adb connect 常常回非 0，所以用 retry
  retry adb connect "$DEVICE"

  # connect 回來也不代表真的可用，補一個快速驗證
  adb -s "$DEVICE" shell true >/dev/null 2>&1
}

reset_adb() {
  adb disconnect "$DEVICE" >/dev/null 2>&1 || true
  adb kill-server >/dev/null 2>&1 || true
  adb start-server >/dev/null 2>&1 || true
}

scrcpy_with_recover_once() {
  # 先試一次
  "${APP[@]}"
  local rc=$?
  if [[ $rc -eq 0 ]]; then
    return 0
  fi

  echo "WARN: scrcpy failed (rc=$rc). Doing one recovery cycle..." >&2

  # 救援流程（只做一次）：重置 ADB + 重建 tunnel + 重連
  reset_adb
  start_tunnel || return $?
  connect_device || return $?

  "${APP[@]}"
  return $?
}

main() {
  if device_ready; then
    echo "Device ready; start mirroring."
    retry scrcpy_with_recover_once
    exit $?
  fi

  echo "Device not ready; set up tunnel and connect..."

  start_tunnel || exit $?
  run_wsl_cmd || echo "WARN: run_wsl_cmd failed; continue anyway." >&2

  connect_device || exit $?

  retry scrcpy_with_recover_once || exit $?
}

main "$@"

